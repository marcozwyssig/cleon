<?xml version="1.0"?>
<!--
  Actifsource generation for cleon, headless (cleon#22).

  Modelled on Actifsource's own example, https://github.com/actifsource/ch.actifsource.example.ant -
  specifically asbuild.dynamic.loading.compile_validate_generate.xml. Actifsource ships an Ant task
  library (`ch.actifsource.ant_*`, providing `actifsource.tasks.detect.xml`) whose tasks boot the
  Actifsource platform themselves. NO RUNNING ECLIPSE IS REQUIRED - which is what makes generation in
  CI possible at all, since this repository wires the generator only as an Eclipse builder
  (`ch.actifsource.environment.builder` in .project) and exposes no headless application.

  Every property below arrives from the caller (the orchestrator), so this file contains no machine
  paths. The example it is based on hardcodes `D:\Eclipse\...`; that is exactly what must not survive
  into CI.

  The bundle folder is an Eclipse `plugins` directory - in CI, the one inside the unpacked asbundle
  bundle, which carries Actifsource. That is the whole reason cleon consumes those bundles.
-->
<project name="cleon-generate" default="generate" basedir="../..">

  <!-- ============================================================================================
       Required properties. Deliberately unset here: -Dname=value from the caller, so nothing in this
       file depends on where anyone's Eclipse lives.

         cleon.bundle.folders   an Eclipse plugins directory carrying ch.actifsource.* (the bundle)
         cleon.workspace.root   the workspace root; no projects are taken FROM it, see below
         cleon.project.folders  where the projects live - this checkout
       ============================================================================================ -->
  <fail unless="cleon.bundle.folders"
        message="cleon.bundle.folders is required: the eclipse/plugins directory of an unpacked asbundle bundle, which supplies ch.actifsource.*"/>
  <fail unless="cleon.project.folders"
        message="cleon.project.folders is required: the directory holding the projects to load (this checkout)"/>
  <!-- The workspace root is the REPOSITORY root, not src/. The root project - the one `resourcescope`
       names - IS this directory: `.project` here says
       `cleonproject.deliverables.architecture.model.architecture`, and its model lives in `asrc/`. The
       generated projects are what live under `src/`, and `cleon.project.folders` points there.
       Conflating the two put the workspace one level below the project it had to find. -->
  <property name="cleon.workspace.root" value="${basedir}"/>

  <!-- Where generation writes. `.asproject` declares `<targetpath><path>src</path>` for exactly the
       three build configurations below, so this is that path made absolute. `generate2` requires the
       attribute and says so plainly - `missing attribute: outputroot` (cleon run 33725170649). -->
  <property name="cleon.output.root" value="${basedir}/src"/>

  <!-- The root project's own location. See the projectFiles note below. -->
  <property name="cleon.project.files" value="${basedir}"/>

  <!-- Relative to each project. Matches .classpath's output folder. -->
  <property name="cleon.project.classes.output" value="bin"/>

  <!-- The root project, whose model generates src/ and doc/. `resourcescope` names it. -->
  <property name="cleon.root.project" value="cleonproject.deliverables.architecture.model.architecture"/>

  <!-- ============================================================================================
       Locate the newest ch.actifsource.ant bundle and import its task definitions. Taken verbatim
       from the vendor example: the bundle name carries a version, so the directory is discovered by
       date rather than pinned - a pinned version would break on every Actifsource update.
       ============================================================================================ -->
  <last id="ch.actifsource.ant.latest.id">
    <sort>
      <date xmlns="antlib:org.apache.tools.ant.types.resources.comparators"/>
      <dirset id="ch.actifsource.ant.set" dir="${cleon.bundle.folders}" includes="ch.actifsource.ant_*"/>
    </sort>
  </last>
  <property name="ch.actifsource.ant.latest" refId="ch.actifsource.ant.latest.id"/>
  <fail message="no ch.actifsource.ant_* bundle under ${cleon.bundle.folders} - is Actifsource installed in that Eclipse? A bundle built without ACTIFSOURCE_USER/ACTIFSOURCE_PASSWORD does not contain it.">
    <condition><not><available file="${ch.actifsource.ant.latest}" type="dir"/></not></condition>
  </fail>
  <echo message="Actifsource ant tasks: ${ch.actifsource.ant.latest}"/>
  <!-- ============================================================================================
       TWO property namespaces, and both are required. This cost a CI run (cleon 33722669190).

         ch.actifsource.antdetect.*   read by actifsource.tasks.detect.xml when it builds the CLASSPATH
                                      for the Ant tasks themselves, at import time
         ch.actifsource.platform.*    passed to each task as a sysproperty, at run time

       Only the second was set. The first defaults to `${eclipse.home}/plugins`, and `eclipse.home` does
       not exist outside a running Eclipse - so antdetect searched a folder called literally
       "${eclipse.home}/plugins" and reported every Actifsource library as missing.

       These are set from the caller's `-D` too, which wins over anything here; the defaults below just
       keep the file runnable on its own.
       ============================================================================================ -->
  <property name="ch.actifsource.antdetect.bundleFolders" value="${cleon.bundle.folders}"/>
  <property name="ch.actifsource.antdetect.bundleFiles" value=""/>

  <!-- The ROOT project, named individually. The vendor's own config says why, in a comment beside its
       workspaceRootFolder: "No projects from this folder are included inside the platform, use
       'ch.actifsource.antdetect.projectFiles'."
       So the workspace root contributes NOTHING to the project set. `projectFolders` covers the
       generated projects under src/, and the root project - which IS this repository directory, and
       which `resourcescope` addresses - has to be listed here or it is not found
       (cleon run 33725593633: `project:cleonproject...architecture not found`). -->
  <property name="ch.actifsource.antdetect.projectFiles" value="${cleon.project.files}"/>

  <property name="ch.actifsource.antdetect.projectFolders" value="${cleon.project.folders}"/>
  <property name="ch.actifsource.antdetect.projectClassesOutput" value="bin"/>

  <import file="${ch.actifsource.ant.latest}/actifsource.tasks.detect.xml"/>

  <!-- The six system properties below are repeated on every task. Ant cannot factor nested elements
       into a macrodef without wrapping the task itself, and wrapping a vendor task to save six lines
       trades a visible repetition for an invisible indirection. They are repeated, and identical. -->

  <!-- ============================================================================================
       Generation.

       THREE BUILD CONFIGURATIONS, resolved from .asproject's GUIDs against the model:

         0e7b1402-333a-11ed-bfa6-7df4b819c530 -> ...template.eclipse.src.BuildConfig_Source_Full
         9ca6e204-3361-11ed-a5c8-59c3bd31a6ea -> ...template.eclipse.feature.BuildConfig_Feature_Full
         45418f54-42bf-11e6-a9d7-97cf4f7c398b -> ...template.eclipse.site.BuildConfig_Site

       Which also answers what the root model produces: the plugin sources, the features, and the
       update site - the 22,524 files under src/ are generated, not hand-written.

       ORDER MATTERS. Sources before features before the site: a feature lists plugins, and the site
       lists features.
       ============================================================================================ -->
  <target name="generate-source">
    <generate2 threadcapacity="1" verbose="false"
               resourcescope="project:${cleon.root.project}"
               buildConfig="cleon.applications.actifsource.metamodel.template.eclipse.src.BuildConfig_Source_Full"
               outputroot="${cleon.output.root}">
      <sysproperty key="ch.actifsource.platform.workspaceRootFolder" value="${cleon.workspace.root}"/>
      <sysproperty key="ch.actifsource.platform.bundleFolders" value="${cleon.bundle.folders}"/>
      <sysproperty key="ch.actifsource.platform.bundleFiles" value=""/>
      <sysproperty key="ch.actifsource.platform.projectFolders" value="${cleon.project.folders}"/>
      <sysproperty key="ch.actifsource.platform.projectFiles" value="${cleon.project.files}"/>
      <sysproperty key="ch.actifsource.platform.projectClassesOutput" value="${cleon.project.classes.output}"/>
    </generate2>
  </target>

  <target name="generate-features" depends="generate-source">
    <generate2 threadcapacity="1" verbose="false"
               resourcescope="project:${cleon.root.project}"
               buildConfig="cleon.applications.actifsource.metamodel.template.eclipse.feature.BuildConfig_Feature_Full"
               outputroot="${cleon.output.root}">
      <sysproperty key="ch.actifsource.platform.workspaceRootFolder" value="${cleon.workspace.root}"/>
      <sysproperty key="ch.actifsource.platform.bundleFolders" value="${cleon.bundle.folders}"/>
      <sysproperty key="ch.actifsource.platform.bundleFiles" value=""/>
      <sysproperty key="ch.actifsource.platform.projectFolders" value="${cleon.project.folders}"/>
      <sysproperty key="ch.actifsource.platform.projectFiles" value="${cleon.project.files}"/>
      <sysproperty key="ch.actifsource.platform.projectClassesOutput" value="${cleon.project.classes.output}"/>
    </generate2>
  </target>

  <target name="generate-site" depends="generate-features">
    <generate2 threadcapacity="1" verbose="false"
               resourcescope="project:${cleon.root.project}"
               buildConfig="cleon.applications.actifsource.metamodel.template.eclipse.site.BuildConfig_Site"
               outputroot="${cleon.output.root}">
      <sysproperty key="ch.actifsource.platform.workspaceRootFolder" value="${cleon.workspace.root}"/>
      <sysproperty key="ch.actifsource.platform.bundleFolders" value="${cleon.bundle.folders}"/>
      <sysproperty key="ch.actifsource.platform.bundleFiles" value=""/>
      <sysproperty key="ch.actifsource.platform.projectFolders" value="${cleon.project.folders}"/>
      <sysproperty key="ch.actifsource.platform.projectFiles" value="${cleon.project.files}"/>
      <sysproperty key="ch.actifsource.platform.projectClassesOutput" value="${cleon.project.classes.output}"/>
    </generate2>
  </target>

  <!-- ============================================================================================
       Validation. `exceptiontype="error"` makes a model error fail the build, which is a gate this
       project does not have today and gets for free here.
       ============================================================================================ -->
  <target name="validate">
    <validate2 verbose="false" threadcapacity="1"
               resourcescope="project:${cleon.root.project}" exceptiontype="error">
      <sysproperty key="ch.actifsource.platform.workspaceRootFolder" value="${cleon.workspace.root}"/>
      <sysproperty key="ch.actifsource.platform.bundleFolders" value="${cleon.bundle.folders}"/>
      <sysproperty key="ch.actifsource.platform.bundleFiles" value=""/>
      <sysproperty key="ch.actifsource.platform.projectFolders" value="${cleon.project.folders}"/>
      <sysproperty key="ch.actifsource.platform.projectFiles" value="${cleon.project.files}"/>
      <sysproperty key="ch.actifsource.platform.projectClassesOutput" value="${cleon.project.classes.output}"/>
    </validate2>
  </target>

  <target name="generate" depends="generate-site,validate"
          description="Generate the plugin sources, the features and the update site, then validate the model."/>
</project>
