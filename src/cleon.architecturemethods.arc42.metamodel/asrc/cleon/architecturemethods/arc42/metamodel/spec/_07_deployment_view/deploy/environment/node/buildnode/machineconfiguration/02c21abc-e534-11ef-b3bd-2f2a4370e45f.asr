  <predicate guid="049ec97d-bce1-11db-8f71-f36774f9949e">
    <object statement-guid="4079aacd-e534-11ef-b3bd-2f2a4370e45f">
      <resource guid="407983ba-e534-11ef-b3bd-2f2a4370e45f">
        <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="407983bc-e534-11ef-b3bd-2f2a4370e45f" type="resource" guid="02c21abc-e534-11ef-b3bd-2f2a4370e45f" />
        </predicate>
        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="444fb911-e534-11ef-b3bd-2f2a4370e45f" type="literal">0</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="5846ce1c-e534-11ef-b3bd-2f2a4370e45f" type="literal">RAID 0 (Striping) distributes data across multiple drives, increasing performance and capacity. However, it provides no redundancy, meaning all data is lost if one drive fails.</object>
        </predicate>
      </resource>
    </object>
    <object statement-guid="59b5a061-e534-11ef-b3bd-2f2a4370e45f">
      <resource guid="59b5794e-e534-11ef-b3bd-2f2a4370e45f">
        <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="59b57950-e534-11ef-b3bd-2f2a4370e45f" type="resource" guid="02c21abc-e534-11ef-b3bd-2f2a4370e45f" />
        </predicate>
        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="5a3d1fe5-e534-11ef-b3bd-2f2a4370e45f" type="literal">1</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="5d054099-e534-11ef-b3bd-2f2a4370e45f" type="literal">RAID 1 (Mirroring) stores identical copies of data on two or more drives. This ensures high data security, but only half of the total storage capacity is usable.</object>
        </predicate>
      </resource>
    </object>
    <object statement-guid="66eec9e4-e534-11ef-b3bd-2f2a4370e45f">
      <resource guid="66eea2d1-e534-11ef-b3bd-2f2a4370e45f">
        <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="66eea2d3-e534-11ef-b3bd-2f2a4370e45f" type="resource" guid="02c21abc-e534-11ef-b3bd-2f2a4370e45f" />
        </predicate>
        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="6a22cbf6-e534-11ef-b3bd-2f2a4370e45f" type="literal">5</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="6e827cd3-e534-11ef-b3bd-2f2a4370e45f" type="literal">RAID 5 combines striping with parity information distributed across all drives. It offers a good balance of capacity, performance, and fault tolerance, allowing recovery from a single drive failure, though the rebuild process can be slow.</object>
        </predicate>
      </resource>
    </object>
    <object statement-guid="719ab959-e534-11ef-b3bd-2f2a4370e45f">
      <resource guid="719a9246-e534-11ef-b3bd-2f2a4370e45f">
        <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="719a9248-e534-11ef-b3bd-2f2a4370e45f" type="resource" guid="02c21abc-e534-11ef-b3bd-2f2a4370e45f" />
        </predicate>
        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="76eeb512-e534-11ef-b3bd-2f2a4370e45f" type="literal">6</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="79cb6f36-e534-11ef-b3bd-2f2a4370e45f" type="literal">RAID 5 combines striping with parity information distributed across all drives. It offers a good balance of capacity, performance, and fault tolerance, allowing recovery from a single drive failure, though the rebuild process can be slow.</object>
        </predicate>
      </resource>
    </object>
    <object statement-guid="7c911eec-e534-11ef-b3bd-2f2a4370e45f">
      <resource guid="7c90d0c9-e534-11ef-b3bd-2f2a4370e45f">
        <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="7c90f7db-e534-11ef-b3bd-2f2a4370e45f" type="resource" guid="02c21abc-e534-11ef-b3bd-2f2a4370e45f" />
        </predicate>
        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="808c1a50-e534-11ef-b3bd-2f2a4370e45f" type="literal">10</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="84555756-e534-11ef-b3bd-2f2a4370e45f" type="literal">RAID 10 (1+0) combines mirroring and striping. It offers high performance and redundancy but requires at least four drives and reduces usable capacity by half.</object>
        </predicate>
      </resource>
    </object>
  </predicate>
