                                          <resource guid="5cdae4e5-2516-11ec-beea-a9d94a6f89e0">
                                            <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                              <object statement-guid="5cddcad6-2516-11ec-beea-a9d94a6f89e0" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="5cddcad7-2516-11ec-beea-a9d94a6f89e0" type="literal"> erfüllt keine expliziten Anforderungen. Bei Bausteinen, welche durch die Dekomposition weitere Sub-Bausteine umfassen, werden die entsprechenden formellen Anforderungen durch die Sub-Bausteine erfüllt.&lt;/db:para&gt;</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
