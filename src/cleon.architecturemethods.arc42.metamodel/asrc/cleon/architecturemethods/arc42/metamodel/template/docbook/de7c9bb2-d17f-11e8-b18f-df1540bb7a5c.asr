                                            <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                              <object statement-guid="460c5269-0df2-11e9-a28e-8b950dcca323" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="460c526a-0df2-11e9-a28e-8b950dcca323" type="literal"> erfüllt keine expliziten Anforderungen. Bei Bausteinen, welche durch die Dekomposition weitere Sub-Bausteine umfassen, werden die entsprechenden formellen Anforderungen durch die Sub-Bausteine erfüllt.&lt;/db:para&gt;</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
