                              <resource guid="3e1e44af-dd5a-11ee-8e8f-8f7b03d71957">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="3e2325e9-dd5a-11ee-8e8f-8f7b03d71957" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                  <object statement-guid="3e234cfd-dd5a-11ee-8e8f-8f7b03d71957">
                                    <resource guid="15b62e7e-dd5a-11ee-8e8f-8f7b03d71957">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="3e234cfb-dd5a-11ee-8e8f-8f7b03d71957" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="3e234cfc-dd5a-11ee-8e8f-8f7b03d71957" type="literal">&lt;db:para&gt;In der Spalte 'Durchschnittsbedarf' wird der durchschnittliche Bedarf an Datenübertragung pro Kommunikationsverbindung in Kilobyte pro Sekunde (kB/s) definiert. Die Spalte 'Summenbetrachtung' hingegen fasst die gesamte Datenmenge unter Berücksichtigung aller beteiligten Kommunikationspartner (Anzahl der Quellen und Ziele in einer bestimmten Umgebung) zusammen.&lt;/db:para&gt;</object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                          <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
