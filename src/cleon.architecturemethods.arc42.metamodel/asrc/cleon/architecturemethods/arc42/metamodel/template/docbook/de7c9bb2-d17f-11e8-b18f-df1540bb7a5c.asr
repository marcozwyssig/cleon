                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="9bad1982-2f4a-11eb-a94a-69eb35614fc8" type="literal">&lt;db:para&gt;In der nachfolgenden Tabelle wird der durchschnittliche Bandbreitenbedarf und den DSCP (Differentiated Services Code Points) für die aufrufenden Verbindungen zu anderen System-Konfigurationen aufgeführt:&lt;/db:para&gt;</object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
