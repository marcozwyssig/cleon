                                <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                  <object statement-guid="21678675-1e45-11e9-865e-41ef48a95f70" type="literal">&lt;db:para&gt;Die System-Konfigurationen, welche keine explizite Sicherungskonfiguration aufweist, verwenden die Sicherungskonfiguration der unterliegenden System-Konfiguration. </object>
