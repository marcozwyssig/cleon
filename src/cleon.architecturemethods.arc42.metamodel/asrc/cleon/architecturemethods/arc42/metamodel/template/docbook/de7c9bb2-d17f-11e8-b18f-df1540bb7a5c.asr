                        <resource guid="3e1ac22c-dd5a-11ee-8e8f-8f7b03d71957">
                          <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                            <object statement-guid="3e1ac231-dd5a-11ee-8e8f-8f7b03d71957" type="resource" guid="cfc4cfd3-c91d-11de-a722-07fb435e032d" />
                          </predicate>
