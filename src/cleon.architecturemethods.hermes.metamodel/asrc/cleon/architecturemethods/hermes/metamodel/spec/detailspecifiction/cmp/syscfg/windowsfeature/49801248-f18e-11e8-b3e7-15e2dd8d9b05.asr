        <predicate guid="80ff75d8-e648-11da-90a0-f358fdc0051b">
          <object statement-guid="f5ee867a-f18e-11e8-b3e7-15e2dd8d9b05" type="literal">Specifies that all subordinate role services, and all subfeatures of parent roles, role services, or features specified by the Name parameter should be installed.</object>
        </predicate>
      </resource>
    </object>
