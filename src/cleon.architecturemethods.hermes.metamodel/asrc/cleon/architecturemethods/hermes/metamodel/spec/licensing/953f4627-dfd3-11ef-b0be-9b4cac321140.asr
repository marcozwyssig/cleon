        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="99e3ee9b-dfd3-11ef-b0be-9b4cac321140" type="literal">Per User License</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="21743768-dfd4-11ef-b0be-9b4cac321140" type="literal">Often used interchangeably with Named User but may also allow for flexible reassignment.</object>
        </predicate>
      </resource>
    </object>
