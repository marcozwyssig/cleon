        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="a2031840-dfd3-11ef-b0be-9b4cac321140" type="literal">Named User License</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="1e12bce7-dfd4-11ef-b0be-9b4cac321140" type="literal">Assigned to a specific individual, meaning only that person can use the software, regardless of how many are licensed.</object>
