        <predicate guid="33fc8660-f91f-11d9-bb45-5fabdff7c7da">
          <object statement-guid="97816d86-dfd3-11ef-b0be-9b4cac321140" type="literal">Floating (Concurrent) License</object>
        </predicate>
        <predicate guid="d63ca21b-a7e7-11e5-82dd-3b995d9c840c">
          <object statement-guid="19e259a6-dfd4-11ef-b0be-9b4cac321140" type="literal">A limited number of licenses shared among multiple users, with only a set number allowed to use the software at the same time.</object>
        </predicate>
      </resource>
    </object>
    <object statement-guid="98a18441-dfd3-11ef-b0be-9b4cac321140">
      <resource guid="98a1843e-dfd3-11ef-b0be-9b4cac321140">
