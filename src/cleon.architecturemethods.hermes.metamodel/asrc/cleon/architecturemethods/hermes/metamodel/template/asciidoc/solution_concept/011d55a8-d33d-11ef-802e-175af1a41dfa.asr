                              <resource guid="58fd12ca-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669af1d0-51bb-11f0-a768-21f9f0df3439" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                  <object statement-guid="669af1d4-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="58fcc4a4-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669af1d2-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669af1d3-51bb-11f0-a768-21f9f0df3439" type="literal">Jeder Abschnitt enthält eine Tabelle, die die jeweiligen Anforderungen auflistet und angibt, ob und wo diese Anforderungen abgedeckt wurden. </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
