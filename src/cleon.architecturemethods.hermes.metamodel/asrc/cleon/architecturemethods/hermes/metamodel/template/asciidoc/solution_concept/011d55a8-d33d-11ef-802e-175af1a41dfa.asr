                              <resource guid="60e9bb89-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669bb53a-51bb-11f0-a768-21f9f0df3439" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                  <object statement-guid="669bb53e-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="60e94653-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669bb53c-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669bb53d-51bb-11f0-a768-21f9f0df3439" type="literal">Ziel ist es, einen klaren Überblick über den aktuellen Stand der Anforderungserfüllung zu geben und mögliche Lücken zu identifizieren.</object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
