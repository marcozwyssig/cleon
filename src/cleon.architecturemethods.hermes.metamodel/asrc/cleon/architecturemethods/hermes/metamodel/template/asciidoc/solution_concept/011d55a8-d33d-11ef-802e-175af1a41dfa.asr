                                  <object statement-guid="669a7c97-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="434e62e7-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669a7c95-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669a7c96-51bb-11f0-a768-21f9f0df3439" type="literal">Die folgenden Abschnitte fassen die Erfüllung der Anforderungen zusammen, wie sie in den entsprechenden Anforderungen definiert wurden. </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                          <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
                            <object statement-guid="669aa3ab-51bb-11f0-a768-21f9f0df3439">
                              <resource guid="23750135-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669aa3aa-51bb-11f0-a768-21f9f0df3439" type="resource" guid="4f50d6ca-d347-11de-87dc-a9aeefa4174b" />
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                        </resource>
                      </object>
                      <object statement-guid="669b18e9-51bb-11f0-a768-21f9f0df3439">
                        <resource guid="58fdd622-51bb-11f0-a768-21f9f0df3439">
                          <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                            <object statement-guid="669acabe-51bb-11f0-a768-21f9f0df3439" type="resource" guid="cfc4cfd3-c91d-11de-a722-07fb435e032d" />
                          </predicate>
                          <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                            <object statement-guid="669af1d5-51bb-11f0-a768-21f9f0df3439">
                              <resource guid="58fd12ca-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669af1d0-51bb-11f0-a768-21f9f0df3439" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                  <object statement-guid="669af1d4-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="58fcc4a4-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669af1d2-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669af1d3-51bb-11f0-a768-21f9f0df3439" type="literal">Jeder Abschnitt enthält eine Tabelle, die die jeweiligen Anforderungen auflistet und angibt, ob und wo diese Anforderungen abgedeckt wurden. </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                          <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
                            <object statement-guid="669b18e8-51bb-11f0-a768-21f9f0df3439">
                              <resource guid="58fdd623-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669b18e7-51bb-11f0-a768-21f9f0df3439" type="resource" guid="4f50d6ca-d347-11de-87dc-a9aeefa4174b" />
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                        </resource>
                      </object>
                      <object statement-guid="669b8e26-51bb-11f0-a768-21f9f0df3439">
                        <resource guid="5c71a089-51bb-11f0-a768-21f9f0df3439">
                          <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                            <object statement-guid="669b3ffb-51bb-11f0-a768-21f9f0df3439" type="resource" guid="cfc4cfd3-c91d-11de-a722-07fb435e032d" />
                          </predicate>
                          <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                            <object statement-guid="669b6712-51bb-11f0-a768-21f9f0df3439">
                              <resource guid="5c710441-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669b3ffd-51bb-11f0-a768-21f9f0df3439" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                  <object statement-guid="669b6711-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="5c7067fb-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669b3fff-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669b6710-51bb-11f0-a768-21f9f0df3439" type="literal">Für die abgedeckten Anforderungen werden die entsprechenden Abschnitte im Dokument referenziert, während nicht abgedeckte Anforderungen entsprechend gekennzeichnet sind. </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                          <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
                            <object statement-guid="669b6715-51bb-11f0-a768-21f9f0df3439">
                              <resource guid="5c71a08a-51bb-11f0-a768-21f9f0df3439">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="669b6714-51bb-11f0-a768-21f9f0df3439" type="resource" guid="4f50d6ca-d347-11de-87dc-a9aeefa4174b" />
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                        </resource>
                      </object>
                      <object statement-guid="669bdc53-51bb-11f0-a768-21f9f0df3439">
                        <resource guid="60ea30c1-51bb-11f0-a768-21f9f0df3439">
                          <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
