                                  <object statement-guid="669a7c97-51bb-11f0-a768-21f9f0df3439">
                                    <resource guid="434e62e7-51bb-11f0-a768-21f9f0df3439">
                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="669a7c95-51bb-11f0-a768-21f9f0df3439" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                        <object statement-guid="669a7c96-51bb-11f0-a768-21f9f0df3439" type="literal">Die folgenden Abschnitte fassen die Erfüllung der Anforderungen zusammen, wie sie in den entsprechenden Anforderungen definiert wurden. </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                          <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
