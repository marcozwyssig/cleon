                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="56e6ee18-a5ab-11ef-9b8e-f9190cfb496d" type="literal">    Often, Jira &amp; Confluence credentials are the same, in which case it is recommended to pass CLI parameters for both entities as</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
