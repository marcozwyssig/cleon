                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="56e232f4-a5ab-11ef-9b8e-f9190cfb496d" type="literal">    Tool expects credentials that belong to an account which has the right permissions to read the JIRA issues for a given project.</object>
