                                      <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                        <object statement-guid="5679d492-a5ab-11ef-9b8e-f9190cfb496d" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                                      </predicate>
                                      <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                                        <object statement-guid="567a22b6-a5ab-11ef-9b8e-f9190cfb496d">
                                          <resource guid="54229d5e-a5ab-11ef-9b8e-f9190cfb496d">
                                            <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                              <object statement-guid="5679fba4-a5ab-11ef-9b8e-f9190cfb496d" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="567a22b5-a5ab-11ef-9b8e-f9190cfb496d" type="literal">     - passed parameters when calling script (-PconfluenceUser=myUsername -PconfluencePass=myPassword) which can be fetched as a secrets on CI/CD or</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
                                <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
