                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="567b5b42-a5ab-11ef-9b8e-f9190cfb496d" type="literal">     - gradle variables set through gradle properties (uses the 'confluenceUser' and 'confluencePass' keys)</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
