                                              <object statement-guid="bdef3e38-a5ae-11ef-9b8e-f9190cfb496d" type="literal">        $docker_args = "run --rm -i --name ${container_name} -e DTC_HEADLESS=1 -e DTC_SITETHEME -e DTC_PROJECT_BRANCH=${DTC_PROJECT_BRANCH} $docker_extra_arguments $env_file_option --entrypoint /bin/bash -v '${PWD}:/project' ${docker_image}:v${version}"</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
