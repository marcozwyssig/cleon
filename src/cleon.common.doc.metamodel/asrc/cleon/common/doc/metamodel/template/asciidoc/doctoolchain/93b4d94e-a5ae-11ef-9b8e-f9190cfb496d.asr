                                              <object statement-guid="bda3412c-a5ae-11ef-9b8e-f9190cfb496d" type="literal">    if ( $null -eq $JAVA_CMD -and $null -ne $env:JAVA_HOME -and $env:JAVA_HOME -ne "") {</object>
