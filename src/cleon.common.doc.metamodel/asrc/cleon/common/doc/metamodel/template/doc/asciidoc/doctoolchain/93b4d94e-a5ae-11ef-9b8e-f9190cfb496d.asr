                                              <object statement-guid="75c3e53f-4dce-11f1-a889-b5809496bd69" type="literal">    if ( $null -eq $JAVA_CMD -and $null -ne $env:JAVA_HOME -and $env:JAVA_HOME -ne "") {</object>
