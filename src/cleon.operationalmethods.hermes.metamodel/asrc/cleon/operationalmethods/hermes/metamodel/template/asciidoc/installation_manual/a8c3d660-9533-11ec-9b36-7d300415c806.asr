                                                    <object statement-guid="ff85e8dc-f5e3-11ec-bcfa-090678875c1c" type="literal">     - gradle variables set through gradle properties (uses the 'confluenceUser' and 'confluencePass' keys)</object>
                                                  </predicate>
                                                </resource>
                                              </object>
                                            </predicate>
                                          </resource>
