                                                  </predicate>
                                                  <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                                    <object statement-guid="ff84b035-f5e3-11ec-bcfa-090678875c1c" type="literal">    Tool expects credentials that belong to an account which has the right permissions to to create and edit confluence pages in the given space.</object>
                                                  </predicate>
                                                </resource>
                                              </object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
