                                            <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                              <object statement-guid="e6578792-9942-11ec-8ab2-a107e9aafcc3" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                            </predicate>
                                            <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                              <object statement-guid="e657aea3-9942-11ec-8ab2-a107e9aafcc3" type="literal">    Often, same credentials are used for Jira &amp; Confluence, in which case it is recommended to pass CLI parameters for both entities as</object>
                                            </predicate>
                                          </resource>
                                        </object>
                                      </predicate>
                                    </resource>
                                  </object>
                                </predicate>
