                                </predicate>
                                <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                  <object statement-guid="2d5f5e60-95c2-11ea-9744-7dd962dc1878" type="literal">				&lt;db:para&gt;Dieses Kapitel beschreibt die Durchführung und Überwachung des Betriebs.&lt;/db:para&gt;</object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                        </resource>
                      </object>
                    </predicate>
                    <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
