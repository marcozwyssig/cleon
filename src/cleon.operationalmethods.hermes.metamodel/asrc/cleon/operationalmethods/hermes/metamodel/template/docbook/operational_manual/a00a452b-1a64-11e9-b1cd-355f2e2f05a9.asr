                        <resource guid="2d517bc7-95c2-11ea-9744-7dd962dc1878">
                          <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                            <object statement-guid="2d5f5e6a-95c2-11ea-9744-7dd962dc1878" type="resource" guid="807c58c6-c946-11de-95d0-4912b8dc029a" />
                          </predicate>
                          <predicate guid="1db32a77-c919-11de-a722-07fb435e032d">
                            <object statement-guid="2d5f5e6e-95c2-11ea-9744-7dd962dc1878">
                              <resource guid="2d517bc8-95c2-11ea-9744-7dd962dc1878">
                                <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                                  <object statement-guid="2d5f5e6c-95c2-11ea-9744-7dd962dc1878" type="resource" guid="9f25a99e-c947-11de-95d0-4912b8dc029a" />
                                </predicate>
                                <predicate guid="527cc4e8-d2ac-11de-87dc-a9aeefa4174b">
                                  <object statement-guid="2d5f5e6d-95c2-11ea-9744-7dd962dc1878" type="literal">				&lt;db:para&gt;Zudem werden die Betriebsüberwachung mit Monitoring, die Alarmierung der System-Konfiguration, die Datensicherung, die Kontrollen zum Datenschutz, die Statistiken, Kennzahlen, Messgrössen und das Vorgehen im Fehlerfall (inkl. organisatorische Aspekte wie Kommunikation etc.) beschrieben.&lt;/db:para&gt;				</object>
                                </predicate>
                              </resource>
                            </object>
                          </predicate>
                        </resource>
                      </object>
                    </predicate>
                    <predicate guid="9f44fa8e-d347-11de-87dc-a9aeefa4174b">
