                  <resource guid="2d517bc4-95c2-11ea-9744-7dd962dc1878">
                    <predicate guid="3169f49a-f91f-11d9-bb45-5fabdff7c7da">
                      <object statement-guid="2d5f5e68-95c2-11ea-9744-7dd962dc1878" type="resource" guid="cfc4cfd3-c91d-11de-a722-07fb435e032d" />
